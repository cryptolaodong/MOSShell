# 小白 1.0 本地配置模板。
# 复制到 .moss_ws/.env 后填写真实值。

# DashScope / Qwen
DASHSCOPE_API_KEY=
XIAOBAI_MODEL=qwen-plus

# TTS，可留空使用 macOS say 降级。
AUDIO_API_KEY=
AUDIO_BASE_URL=https://api.openai.com/v1
AUDIO_TTS_MODEL=gpt-4o-mini-tts
AUDIO_TTS_VOICE=ash
AUDIO_TTS_INSTRUCTIONS=用温暖、自然、像儿童陪伴机器人一样的语气说话。

# Reachy
REACHY_HOST=192.168.31.222
